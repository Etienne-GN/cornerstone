<?xml version="1.0" encoding="UTF-8"?>
<schemalist gettext-domain="gnome-shell-extensions">
  <enum id='org.gnome.shell.extensions.cornerstone.actionCenterBannerClick'>
    <value value='0' nick='open-action-center'/>
    <value value='1' nick='activate'/>
  </enum>
  <schema path="/org/gnome/shell/extensions/cornerstone/" id="org.gnome.shell.extensions.cornerstone">
    <key type="b" name="mirror-indicators">
      <default>true</default>
      <summary>Mirror status indicators</summary>
      <description>Mirror top bar status indicators on the other monitors.</description>
    </key>
    <key type="s" name="mirror-indicator-visibility">
      <default>'{}'</default>
      <summary>Mirrored indicator visibility</summary>
      <description>Per-monitor visibility of mirrored indicators (JSON).</description>
    </key>
    <key type="s" name="mirror-indicator-catalog">
      <default>'{}'</default>
      <summary>Mirrored indicator catalog</summary>
      <description>Indicators known to the mirror, per monitor (JSON).</description>
    </key>
    <key type="b" name="action-center">
      <default>true</default>
      <summary>Action Center</summary>
      <description>Show quick settings, notifications and the calendar in one popup.</description>
    </key>
    <key name="action-center-banner-click" enum="org.gnome.shell.extensions.cornerstone.actionCenterBannerClick">
      <default>'open-action-center'</default>
      <summary>Notification banner click</summary>
      <description>What clicking a notification banner does while the Action Center is on: open the Action Center, or activate the notification as GNOME does.</description>
    </key>
  </schema>
</schemalist>
